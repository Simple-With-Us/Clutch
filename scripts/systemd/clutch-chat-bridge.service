[Unit]
Description=Clutch chat bridge (MiniMax Code remote sidecar)
Documentation=file:__ROOT__/docs/minimax-code-server.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Environment=HOME=__HOME__
Environment=CLUTCH_HOME=__HOME__/.clutch
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/scripts/chat-bridge.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
