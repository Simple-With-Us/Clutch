{
  "name": "harness",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Friendly adaptation of @deepseek-ai/dsh extended for DSH and MiniMax harness parity.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaywedgeworth22/Harness.git"
  },
  "homepage": "https://github.com/jaywedgeworth22/Harness",
  "bugs": {
    "url": "https://github.com/jaywedgeworth22/Harness/issues"
  },
  "files": [
    "src",
    "bridges",
    "scripts",
    "docs",
    "assets",
    "NOTICE",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./dsh/acp": "./src/dsh/acp/driver.ts",
    "./dsh/acp/driver": "./src/dsh/acp/driver.ts",
    "./dsh/mcp-patch": "./src/dsh/acp/mcp-patch.ts",
    "./mmh/acp": "./src/mmh/acp/driver.ts",
    "./mmh/acp/driver": "./src/mmh/acp/driver.ts",
    "./mmh/http-client": "./src/mmh/http-client/index.ts",
    "./shared/contracts": "./src/shared/contracts.ts",
    "./shared/acp-core": "./src/shared/acp-core.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "harness-web": "./src/web/start-web.ts",
    "harness-serve-tailscale": "./src/web/serve-tailscale.ts",
    "harness-open": "./src/web/open-harness.ts",
    "harness-ensure": "./src/web/ensure-web.ts",
    "harness-install-dock": "./src/web/install-dock-app.ts",
    "harness-sync-profiles": "./scripts/sync-profiles.ts"
  },
  "scripts": {
    "sync": "tsx scripts/sync-profiles.ts",
    "web": "tsx src/web/start-web.ts --no-open --host 127.0.0.1 --port 3080",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci-scope": "vitest run --typecheck",
    "test:e2e": "playwright test"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
