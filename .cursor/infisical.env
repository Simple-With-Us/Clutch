# Clutch Infisical coordinates for Cursor cloud agents.
#  Committed per-repo non-secrets only — never credentials.
#  Secret values come from the Clutch Infisical project at runtime
#  (universal-auth via INFISICAL_CLIENT_ID / INFISICAL_CLIENT_SECRET,
#  which the Cursor dashboard injects).
#  See INFISICAL.md in this repo for the full key inventory.

INFISICAL_PROJECT_ID=077fd6f3-9f9b-438e-9b6f-5c69076cf36c
INFISICAL_ENV=dev
INFISICAL_DOMAIN=https://app.infisical.com
